APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Where the clinic physically is. Schedule rows hold wall-clock times, so
# this must match them or the TV board open/closed state is eight hours out.
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Must be reverb wherever the live queue should work. `log` raises no error:
# every update silently goes to the log file and the TV board never moves.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Reverb (WebSockets) ---------------------------------------------------
# `php artisan reverb:install` fills the ID/key/secret. REVERB_APP_KEY is not
# a secret (it ships inside both apps) but must equal VITE_REVERB_APP_KEY in
# web/.env and EXPO_PUBLIC_REVERB_APP_KEY in mobile, or every socket is
# refused. REVERB_APP_SECRET is a secret. HOST/PORT/SCHEME are where this API
# publishes events to Reverb.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

CLINIC_NAME="UDD Clinic"
CLINIC_INSTITUTION="Universidad de Dagupan"
CLINIC_ADDRESS=

# --- Security (see config/security.php and config/cors.php) ---------------
# Browser origins allowed to call the API, comma-separated. Must include the
# web app's origin or live queue updates (broadcasting/auth) break.
# Dev: the Vite dev server. Prod: the deployed web domain, https.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Requests per minute. Bump before a busy event day; no code change needed.
RATE_LIMIT_API=120
RATE_LIMIT_GUEST=300
RATE_LIMIT_AUTH=5
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_SENSITIVE=5
