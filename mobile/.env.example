# Copy to .env for local development. Every value is compiled into the app
# bundle, so nothing here is a secret.
#
# EAS cloud builds never see this file (it is gitignored and EAS uploads only
# tracked files). Production values go in the build profile's "env" block in
# eas.json, or in EAS environment variables — see DEPLOYMENT.md.

# Android emulator: use http://10.0.2.2:8000/api
# Physical device: use your machine's LAN IP, e.g. http://192.168.1.10:8000/api
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Reverb (WebSocket) connection — host should match the machine running
# `php artisan reverb:start` (10.0.2.2 for Android emulator, LAN IP for a device).
# The key must equal REVERB_APP_KEY in api/.env.
EXPO_PUBLIC_REVERB_APP_KEY=
EXPO_PUBLIC_REVERB_HOST=127.0.0.1
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http
