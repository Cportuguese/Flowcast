# API base URL (with /api). Its origin is added to the production CSP.
VITE_API_URL=http://127.0.0.1:8000/api

# Reverb (WebSocket) — must match the API's REVERB_* values.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Extra origins the production build may connect to (comma-separated).
# Normally empty; the API and Reverb origins above are added automatically.
VITE_CSP_CONNECT_SRC=
